datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  DEVOPS_ENGINEER
  DEVELOPER
  SECURITY_AUDITOR
  VIEWER
}

enum PipelineStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  BLOCKED
}

enum RunnerStatus {
  ONLINE
  BUSY
  OFFLINE
  DRAINING
}

enum DriftStatus {
  IN_SYNC
  DRIFT_DETECTED
  SCAN_FAILED
  UNKNOWN
}

model Tenant {
  id               String      @id @default(uuid())
  name             String
  slug             String      @unique
  plan             String      @default("ENTERPRISE")
  concurrencyLimit Int         @default(20)
  maxRunners       Int         @default(50)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  users            User[]
  apiKeys          ApiKey[]
  pipelines        Pipeline[]
  runners          Runner[]
  iacWorkspaces    IaCWorkspace[]
  k8sClusters      K8sCluster[]
  secrets          EncryptedSecret[]
  auditLogs        AuditLog[]
}

model User {
  id               String      @id @default(uuid())
  tenantId         String
  email            String      @unique
  name             String
  passwordHash     String
  role             UserRole    @default(DEVELOPER)
  mfaSecret        String?
  mfaEnabled       Boolean     @default(false)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
}

model ApiKey {
  id               String      @id @default(uuid())
  name             String
  prefix           String
  hashedSecret     String
  tenantId         String
  userId           String
  scopes           String[]
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EncryptedSecret {
  id               String      @id @default(uuid())
  tenantId         String
  name             String
  encryptedValue   String
  nonce            String
  authTag          String
  keyVersion       Int         @default(1)
  description      String?
  environment      String      @default("global")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, environment])
}

model AuditLog {
  id               String      @id @default(uuid())
  sequenceNumber   BigInt      @default(autoincrement())
  tenantId         String
  userId           String
  userEmail        String
  action           String
  resourceType     String
  resourceId       String
  ipAddress        String
  userAgent        String
  detailsJson      String
  previousHash     String
  currentHash      String
  timestamp        DateTime    @default(now())

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
}

model Pipeline {
  id               String      @id @default(uuid())
  tenantId         String
  name             String
  description      String?
  repositoryUrl    String?
  defaultBranch    String      @default("main")
  definitionYaml   String
  timeoutMinutes   Int         @default(60)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs             PipelineRun[]
}

model PipelineRun {
  id               String         @id @default(uuid())
  pipelineId       String
  tenantId         String
  runNumber        Int
  status           PipelineStatus @default(QUEUED)
  triggerType      String
  triggerActor     String
  commitSha        String?
  branch           String?
  durationMs       Int            @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime       @default(now())

  pipeline         Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  steps            StepRun[]
}

model StepRun {
  id               String      @id @default(uuid())
  runId            String
  stepName         String
  status           String      @default("PENDING")
  exitCode         Int?
  runnerId         String?
  durationMs       Int         @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  logPath          String?

  run              PipelineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Runner {
  id               String       @id @default(uuid())
  tenantId         String
  name             String
  type             String       @default("DOCKER_ISOLATED")
  status           RunnerStatus @default(OFFLINE)
  version          String
  os               String
  arch             String
  ipAddress        String
  tags             String[]
  lastHeartbeat    DateTime     @default(now())
  createdAt        DateTime     @default(now())

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model IaCWorkspace {
  id               String      @id @default(uuid())
  tenantId         String
  name             String
  provider         String
  tool             String      @default("TERRAFORM")
  workingDirectory String      @default(".")
  repositoryUrl    String
  branch           String      @default("main")
  isLocked         Boolean     @default(false)
  lockedBy         String?
  driftStatus      DriftStatus @default(UNKNOWN)
  lastDriftScanAt  DateTime?
  resourceCount    Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model K8sCluster {
  id               String      @id @default(uuid())
  tenantId         String
  name             String
  environment      String
  apiEndpoint      String
  version          String
  health           String      @default("HEALTHY")
  lastPing         DateTime    @default(now())
  createdAt        DateTime    @default(now())

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
